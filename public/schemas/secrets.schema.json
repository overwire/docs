{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://docs.overwire.io/schemas/secrets.schema.json",
  "title": "Secret declarations",
  "description": "Secret names with optional metadata and local-only literal values, resolved as ${{ secrets.NAME }}. (.overwire/secrets.yml)",
  "type": "object",
  "additionalProperties": {
    "anyOf": [
      {
        "type": "null"
      },
      {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      },
      {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "value": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        },
        "additionalProperties": false
      }
    ]
  }
}
