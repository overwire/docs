{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://docs.overwire.io/schemas/environment-protection.schema.json",
  "title": "Environment protection",
  "description": "Protection rules (reviewers, wait timer) for one deployment environment. (.overwire/environments/<name>/protection.yml)",
  "type": "object",
  "properties": {
    "required_reviewers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "wait_timer": {
      "type": "number"
    },
    "auto_approve": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
